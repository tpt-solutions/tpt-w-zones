{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "tpt-zones",
  "version": "0.1.0",
  "identifier": "com.tptsolutions.tpt-zones",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build && cargo build --release -p zones-cli",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "tpt-zones",
        "width": 1100,
        "height": 720,
        "minWidth": 720,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "../../../target/release/tpt-zones-cli.exe": "tpt-zones-cli.exe"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "TPT Solutions",
    "category": "Utility",
    "shortDescription": "Advanced window tiling and workspace manager",
    "license": "MIT OR Apache-2.0"
  }
}
